# Supabase (Vite requires the VITE_ prefix — not NEXT_PUBLIC_)
# Dashboard: https://supabase.com/dashboard/project/jhmepthfxnpmwpjobumj
# Dev server port: repo defaults to 5175 so another app can use 5173. Override with VITE_DEV_PORT or PORT.
# VITE_DEV_PORT=5175
VITE_SUPABASE_URL=https://jhmepthfxnpmwpjobumj.supabase.co
# Use "anon" / "publishable" public key from Project Settings → API (JWT or sb_publishable_…)
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional alias if you prefer to name the new publishable key separately (see src/lib/supabase.ts)
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Only for running scripts (create-admin, setup-supabase). Do not commit the service role key.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: ADMIN_EMAIL=you@lamtek.co.uk  ADMIN_PASSWORD=ChangeMeAdmin1!
# Promote existing user to admin: PROMOTE_EMAIL=you@lamtek.co.uk  npm run promote-to-admin
# For npm run seed and `npm run db:push:remote`: Project Settings → Database → Connection string → URI (include password)
# DATABASE_URL=postgresql://postgres.jhmepthfxnpmwpjobumj:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Alternative (gitignored): create `.secrets/database_url` with that URI on a single line — see scripts/push-migrations.mjs

# Playwright: optional customer user for tests/e2e/customer-order-flow.spec.ts (non-staff account)
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
# CI: set E2E_RUN_DEMO=1 to run tests/e2e/demo-flow.spec.ts (requires seeded DEMO-* orders / demo users)
