{
  "name": "lamtek-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install-browsers": "playwright install chromium",
    "setup:supabase": "node scripts/setup-supabase.js",
    "setup:lamtek-admin": "node --env-file=.env scripts/setup-lamtek-admin.js",
    "update:bucket-limit": "node --env-file=.env scripts/update-documents-bucket-limit.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "promote-to-admin": "node --env-file=.env scripts/promote-to-admin.js",
    "seed-dummy-users": "node --env-file=.env scripts/seed-dummy-users.js",
    "create-demo-customer": "node --env-file=.env scripts/create-demo-customer.js",
    "record:admin-videos": "node --env-file=.env scripts/record-admin-section-videos.mjs",
    "supabase": "npx supabase",
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link --project-ref jhmepthfxnpmwpjobumj",
    "supabase:link:token": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-link-lamtek.ps1",
    "supabase:push": "npx supabase db push",
    "db:migrate": "npx supabase db push",
    "db:push:remote": "node --env-file=.env scripts/push-migrations.mjs",
    "db:clear-products": "node --env-file=.env scripts/clear-all-products.mjs",
    "deploy:vercel": "vercel deploy --prod --yes",
    "supabase:status": "npx supabase status",
    "seed": "node --env-file=.env scripts/run-seed.js",
    "create-demo-orders": "node --env-file=.env scripts/create-demo-orders.js",
    "seed-rich-demo": "node --env-file=.env scripts/seed-rich-demo.js",
    "import-pricelist": "node --env-file=.env scripts/import-pricelist-pdf.js",
    "import-lamtek-pricelists": "node --env-file=.env scripts/import-lamtek-trade-pricelists.js",
    "assign-images": "node --env-file=.env scripts/assign-product-images.js",
    "authorize:lamtek": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/authorize-lamtek-context.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^29.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.19.0",
    "sharp": "^0.33.5",
    "supabase": "^2.88.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.4"
  }
}
